{
  "actorSpecification": 1,
  "name": "india-stock-fundamentals-scraper",
  "title": "Moneycontrol + Screener Stock Data Validator",
  "description": "Compare Indian stock data from Moneycontrol and Screener.in for $2 per 1,000 stocks. Get percentage differences, mismatch flags, source timestamps, fiscal-period warnings, agreement scores, and traceability.",
  "version": "1.1",
  "buildTag": "latest",
  "categories": ["BUSINESS", "DEVELOPER_TOOLS"],
  "categoriesVersion": "1.0.0",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "dockerfile": "Dockerfile",
  "exampleRunInput": {
    "body": "{\"symbols\":[\"RELIANCE\"],\"source\":\"both\",\"comparisonTolerancePercent\":2,\"requireBothSources\":true,\"consolidated\":true,\"includeFinancials\":false,\"includeShareholding\":false,\"maxResults\":1,\"maxConcurrency\":1,\"proxyConfiguration\":{\"useApifyProxy\":false}}",
    "contentType": "application/json; charset=utf-8"
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 256,
    "timeoutSecs": 900
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "eventPriceUsd": 0.00005,
          "isOneTimeEvent": true
        },
        "stock-scraped": {
          "eventTitle": "Stock scraped",
          "eventDescription": "One requested single-source record or Moneycontrol + Screener comparison stored in the default dataset.",
          "eventPriceUsd": 0.002,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 1024,
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "stocks": {
          "title": "Moneycontrol + Screener comparisons",
          "transformation": {
            "fields": [
              "symbol",
              "companyName",
              "comparisonStatus",
              "agreementPercent",
              "discrepancyCount",
              "unitMismatchCount",
              "fiscalPeriodAlignmentStatus",
              "currentPrice",
              "dayChangePercent",
              "marketCapCrore",
              "peRatio",
              "pbRatio",
              "roePercent",
              "rocePercent",
              "promoterHoldingPercent",
              "sector",
              "scrapedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "symbol": { "label": "Symbol", "format": "text" },
              "companyName": { "label": "Company", "format": "text" },
              "comparisonStatus": { "label": "Comparison", "format": "text" },
              "agreementPercent": { "label": "Agreement %", "format": "number" },
              "discrepancyCount": { "label": "Discrepancies", "format": "number" },
              "unitMismatchCount": { "label": "Unit warnings", "format": "number" },
              "fiscalPeriodAlignmentStatus": { "label": "Fiscal alignment", "format": "text" },
              "currentPrice": { "label": "Price (INR)", "format": "number" },
              "dayChangePercent": { "label": "Day change %", "format": "number" },
              "marketCapCrore": { "label": "Market cap (Cr)", "format": "number" },
              "peRatio": { "label": "P/E", "format": "number" },
              "pbRatio": { "label": "P/B", "format": "number" },
              "roePercent": { "label": "ROE %", "format": "number" },
              "rocePercent": { "label": "ROCE %", "format": "number" },
              "promoterHoldingPercent": { "label": "Promoter %", "format": "number" },
              "sector": { "label": "Sector", "format": "text" },
              "scrapedAt": { "label": "Scraped at", "format": "date" }
            }
          }
        }
      }
    }
  }
}
